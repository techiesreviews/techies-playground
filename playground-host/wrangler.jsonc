{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Our copy of WordPress Playground. CI builds it from the official repository at the
  // release that matches @wp-playground/client in package.json and prepares ./dist with
  // scripts/prepare-playground-host.mjs before deploying.
  "name": "playground-wp",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve /remote.html as is; the default would redirect it to /remote.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "wp.techies.tools",
      "custom_domain": true
    }
  ],
  // Off: proxied URLs can carry licence keys (activation requests from WordPress), and
  // invocation logs would store them.
  "observability": {
    "enabled": false
  },
  // Per-visitor limit for the CORS proxy (cors-proxy.js). A launch with plugins makes a
  // few dozen proxied requests; WordPress admin pages add a few per page.
  "ratelimits": [
    {
      "name": "CORS_PROXY_LIMIT",
      "namespace_id": "2361",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "playground-wp-preview",
      "ratelimits": [
        {
          "name": "CORS_PROXY_LIMIT",
          "namespace_id": "2362",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "preview-wp.techies.tools",
          "custom_domain": true
        }
      ]
    }
  }
}
