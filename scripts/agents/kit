#!/usr/bin/env bash
# Usage: kit [<command> [args]] | kit --home; the Agent Kit launcher kit init writes into each project. Runs the
# machine's newest kit (${XDG_DATA_HOME:-~/.local/share}/agent-kit/current) for the whole command; a person's
# KIT_HOME wins. --home prints that kit's folder and runs nothing (for a project's own helpers and forwarders).
set -euo pipefail
export KIT_REPO=${KIT_REPO:-https://github.com/techiesreviews/agent-kit.git}
data=${XDG_DATA_HOME:-} cache=${XDG_CACHE_HOME:-} why=KIT_HOME clone='' picked=false
[[ $data == /* ]] || data=${HOME:-$(cd ~ && pwd -P)}/.local/share
[[ $cache == /* ]] || cache=${HOME:-$(cd ~ && pwd -P)}/.cache
# A whole kit, as kit update checks it: the front door needs kit-lib.sh beside kit. The hook launcher also needs
# hooks/run.sh, so a pinned folder missing only that is kept here but looked up again there.
whole() { [[ -x $1/kit && -f $1/kit-lib.sh ]]; }
# KIT_HOME_PINNED marks a KIT_HOME a launcher picked, so a child whose folder kit update has since removed
# picks again instead of treating it as a person's choice.
if [[ -z ${KIT_HOME:-} || $KIT_HOME == "${KIT_HOME_DEFAULT:-}" ]] || { [[ $KIT_HOME == "${KIT_HOME_PINNED:-}" ]] && ! whole "$KIT_HOME"; }; then
  picked=true
  # current is read once: the command keeps this folder while kit update swaps the link.
  KIT_HOME=$(readlink -- "$data/agent-kit/current" 2>/dev/null) || KIT_HOME=''
  [[ -z $KIT_HOME || $KIT_HOME == /* ]] || KIT_HOME=$data/agent-kit/$KIT_HOME
  # No machine copy (CI, a cloud session, a new laptop): one shallow clone in the cache, stamped for kit version;
  # a clone that is not a whole kit is thrown away. The rename is plain mv (macOS has no mv -T): a launcher that
  # lost the race moves its clone into the winner's folder, and throws it away from there (one killed in between
  # leaves that clone inside the winner's folder, unused, where it used to stay beside it).
  whole "$KIT_HOME" || KIT_HOME=$cache/agent-kit why="$cache/agent-kit exists but holds no kit; remove it"
  if [[ ! -e $KIT_HOME ]]; then
    why="no machine copy; cannot clone $KIT_REPO"
    trap '[[ -z $clone ]] || rm -rf -- "$clone"' EXIT
    mkdir -p -- "$cache" && clone=$(mktemp -d "$cache/agent-kit.XXXXXX") && git clone -q --depth 1 -- "$KIT_REPO" "$clone" >&2 &&
      { whole "$clone" || { why="the clone of $KIT_REPO holds no whole kit"; false; }; } &&
      { date +%s > "$clone/.git/kit-cloned" || { why="cannot stamp the clone in $cache"; false; }; } &&
      why="cannot place the clone at $KIT_HOME" && mv -- "$clone" "$KIT_HOME" 2>/dev/null &&
      { if [[ -e $KIT_HOME/${clone##*/} ]]; then clone=$KIT_HOME/${clone##*/}; else clone=''; fi; } || :
    [[ -z $clone ]] || rm -rf -- "$clone"
  fi
fi
whole "$KIT_HOME" || { printf 'RESULT: fail no Agent Kit at %s (%s)\n' "$KIT_HOME" "$why"; exit 2; }
# The front door resolves KIT_HOME the same way, so the marker still matches it in every child.
if [[ $picked == true ]]; then
  folder=$KIT_HOME
  KIT_HOME=$(cd -- "$folder" 2>/dev/null && pwd -P) || { printf 'RESULT: fail no Agent Kit at %s (removed while starting)\n' "$folder"; exit 2; }
  export KIT_HOME_PINNED=$KIT_HOME
fi
# Outside git the project is the one around this launcher, not around the kit.
if [[ -z ${KIT_ROOT:-} ]] && ! git rev-parse --show-toplevel > /dev/null 2>&1; then
  KIT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P) && export KIT_ROOT
fi
export KIT_HOME
if [[ ${1-} == --home && $# == 1 ]]; then printf '%s\n' "$KIT_HOME"; exit 0; fi
exec "$KIT_HOME/kit" "$@"
