#!/usr/bin/env bash
# kit: build the Vite app with the existing npm script
set -euo pipefail
if [[ ${1-} == --help || ${1-} == -h ]]; then
  printf 'Usage: kit build\nRun npm run build; writes dist/ without deploying.\n'
  exit 0
fi
if (( $# )); then
  printf 'Usage: kit build\n' >&2
  exit 2
fi
cd "$KIT_ROOT"
exec npm run build
